# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method stress)
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "xy_fit.pdf"

set title "Stress-Strain Fit: XY direction (C_xy = 65.08 GPa, R^2=0.99994)"
set xlabel "Engineering strain (fraction)"
set ylabel "sigma_xy (GPa)"
set grid
set key top left
f(x) = 65.07720914*x + -0.01493229
plot "xy_fit.dat" using 2:8 with points pt 7 ps 1.3 lc rgb "#cc5522" title "sigma_xy data", \
     f(x) with lines lc rgb "#cc5522" dt 2 title "Linear fit"
