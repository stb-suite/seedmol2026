# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method stress)
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "xx_fit.pdf"

set title "Stress-Strain Fit: XX direction (C_xx = 92.42 GPa, R^2=0.99864)"
set xlabel "Engineering strain (fraction)"
set ylabel "sigma_xx (GPa)"
set grid
set key top left
f(x) = 92.41675064*x + -0.09440025
plot "xx_fit.dat" using 2:3 with points pt 7 ps 1.3 lc rgb "#2255cc" title "sigma_xx data", \
     f(x) with lines lc rgb "#2255cc" dt 2 title "Linear fit"
