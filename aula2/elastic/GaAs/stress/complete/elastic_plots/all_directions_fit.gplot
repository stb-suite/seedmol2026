# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method stress)
set terminal pdfcairo enhanced color font "Arial,14" size 8,6
set output "all_directions_fit.pdf"

set title "Stress-Strain Fits -- All Directions"
set xlabel "Engineering strain (fraction)"
set ylabel "Stress (GPa)"
set grid
set key top left
f_0(x) = 92.41675064*x + -0.09440025
f_1(x) = 65.07720914*x + -0.01493229
plot "all_directions_fit.dat" index 0 using 2:3 with points pt 7 ps 1.2 lc rgb "#2255cc" title "XX", \
     f_0(x) with lines lc rgb "#2255cc" dt 2 notitle, \
     "all_directions_fit.dat" index 1 using 2:3 with points pt 7 ps 1.2 lc rgb "#cc5522" title "XY", \
     f_1(x) with lines lc rgb "#cc5522" dt 2 notitle
