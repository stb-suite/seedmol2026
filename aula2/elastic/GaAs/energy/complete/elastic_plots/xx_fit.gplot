# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method energy)
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "xx_fit.pdf"

set title "Energy-Strain Fit: xx pattern"
set xlabel "Strain (fraction)"
set ylabel "Total energy (eV)"
set grid
set key top left
f(x) = 1.40664286e+01*x**2 + -1.99900000e-02*x + -4966.60234989
plot "xx_fit.dat" using 2:3 with points pt 7 ps 1.3 lc rgb "#2255cc" title "xx data", \
     f(x) with lines lc rgb "#2255cc" dt 2 title "Parabolic fit"
