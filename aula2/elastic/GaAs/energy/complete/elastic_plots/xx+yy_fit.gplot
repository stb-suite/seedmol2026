# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method energy)
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "xx+yy_fit.pdf"

set title "Energy-Strain Fit: xx+yy pattern"
set xlabel "Strain (fraction)"
set ylabel "Total energy (eV)"
set grid
set key top left
f(x) = 4.05342857e+01*x**2 + -6.97200000e-02*x + -4966.60236986
plot "xx+yy_fit.dat" using 2:3 with points pt 7 ps 1.3 lc rgb "#cc5522" title "xx+yy data", \
     f(x) with lines lc rgb "#cc5522" dt 2 title "Parabolic fit"
