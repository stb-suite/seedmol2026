# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method energy)
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "yz_fit.pdf"

set title "Energy-Strain Fit: yz pattern"
set xlabel "Strain (fraction)"
set ylabel "Total energy (eV)"
set grid
set key top left
f(x) = 3.92421429e+01*x**2 + -1.79700000e-02*x + -4966.60237663
plot "yz_fit.dat" using 2:3 with points pt 7 ps 1.3 lc rgb "#22aa55" title "yz data", \
     f(x) with lines lc rgb "#22aa55" dt 2 title "Parabolic fit"
