# --- STB Plot Configuration ---
# Generated by stb-elasticAnalysis (--method energy)
set terminal pdfcairo enhanced color font "Arial,14" size 8,6
set output "all_patterns_fit.pdf"

set title "Energy-Strain Fits -- All Patterns"
set xlabel "Strain (fraction)"
set ylabel "Total energy (eV)"
set grid
set key top left
f_0(x) = 1.40664286e+01*x**2 + -1.99900000e-02*x + -4966.60234989
f_1(x) = 4.05342857e+01*x**2 + -6.97200000e-02*x + -4966.60236986
f_2(x) = 3.92421429e+01*x**2 + -1.79700000e-02*x + -4966.60237663
plot "all_patterns_fit.dat" index 0 using 2:3 with points pt 7 ps 1.2 lc rgb "#2255cc" title "xx", \
     f_0(x) with lines lc rgb "#2255cc" dt 2 notitle, \
     "all_patterns_fit.dat" index 1 using 2:3 with points pt 7 ps 1.2 lc rgb "#cc5522" title "xx+yy", \
     f_1(x) with lines lc rgb "#cc5522" dt 2 notitle, \
     "all_patterns_fit.dat" index 2 using 2:3 with points pt 7 ps 1.2 lc rgb "#22aa55" title "yz", \
     f_2(x) with lines lc rgb "#22aa55" dt 2 notitle
