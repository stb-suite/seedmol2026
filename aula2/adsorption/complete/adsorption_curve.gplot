# --- STB Plot Configuration ---
# Generated by stb-adsorbAnalysis
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "adsorption_curve.pdf"

set title "Adsorption energy per site"
set xlabel "Site index"
set ylabel "E_{ads} (eV)"
set grid
set key top right
plot "adsorption_curve.dat" using 1:2 with points pt 7 ps 2 lc rgb "#2255cc" title "E_{ads}", "adsorption_curve.dat" using 1:3 with points pt 9 ps 2 lc rgb "#cc5522" title "E_{ads} (BSSE)"
