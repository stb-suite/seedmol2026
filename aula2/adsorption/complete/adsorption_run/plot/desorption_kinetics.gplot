# --- STB Plot Configuration ---
# Generated by stb-adsorbGibbs -- ROUGH Eyring-TST desorption-kinetics
# estimate (barrierless assumption, no real kinetic barrier computed).
set terminal pdfcairo enhanced color font "Arial,14" size 7,5
set output "desorption_kinetics.pdf"

set title "Desorption timescale (rough estimate) -- site_1_ontop"
set xlabel "Temperature (K)"
set ylabel "{/Symbol t}_{desorb} (s)"
set logscale y
set grid
set key top right
plot "desorption_kinetics.dat" using 1:4 with linespoints lw 2 pt 7 lc rgb "#cc5522" title "{/Symbol t}_{desorb} (rough estimate, lower bound)"
