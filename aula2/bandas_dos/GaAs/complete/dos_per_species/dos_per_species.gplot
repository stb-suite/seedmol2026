set terminal pdfcairo enhanced font "Arial,14" size 8,6
set output "dos_per_species.pdf"
set xlabel "Energy (eV)"
set ylabel "DOS (states/eV)"
set key outside
set grid
plot "dos_As.dat" using 1:2 with lines lw 2 title "As: s", \
     "dos_As.dat" using 1:3 with lines lw 2 title "As: p", \
     "dos_As.dat" using 1:4 with lines lw 2 title "As: d", \
     "dos_Ga.dat" using 1:2 with lines lw 2 title "Ga: s", \
     "dos_Ga.dat" using 1:3 with lines lw 2 title "Ga: p", \
     "dos_Ga.dat" using 1:4 with lines lw 2 title "Ga: d"
