set terminal pdfcairo enhanced font "Arial,14" size 8,6
set output "dos_per_atom.pdf"
set xlabel "Energy (eV)"
set ylabel "DOS (states/eV)"
set key outside
set grid
plot "B_1.dat" using 1:2 with lines lw 2 title "B_1: s", \
     "B_1.dat" using 1:3 with lines lw 2 title "B_1: p", \
     "B_1.dat" using 1:4 with lines lw 2 title "B_1: d", \
     "N_2.dat" using 1:2 with lines lw 2 title "N_2: s", \
     "N_2.dat" using 1:3 with lines lw 2 title "N_2: p", \
     "N_2.dat" using 1:4 with lines lw 2 title "N_2: d"
