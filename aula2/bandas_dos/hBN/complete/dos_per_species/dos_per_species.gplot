set terminal pdfcairo enhanced font "Arial,14" size 8,6
set output "dos_per_species.pdf"
set xlabel "Energy (eV)"
set ylabel "DOS (states/eV)"
set key outside
set grid
plot "dos_B.dat" using 1:2 with lines lw 2 title "B: s", \
     "dos_B.dat" using 1:3 with lines lw 2 title "B: p", \
     "dos_B.dat" using 1:4 with lines lw 2 title "B: d", \
     "dos_N.dat" using 1:2 with lines lw 2 title "N: s", \
     "dos_N.dat" using 1:3 with lines lw 2 title "N: p", \
     "dos_N.dat" using 1:4 with lines lw 2 title "N: d"
