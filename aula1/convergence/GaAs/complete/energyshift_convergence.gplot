# --- STB Plot Configuration ---
# Generated by stb-convergenceAnalysis
set terminal pdfcairo enhanced color font "Arial,14" size 7,8
set output "energyshift_convergence.pdf"

set multiplot layout 2,1

set grid
set title "Convergence: energyshift (energy)"
set xlabel "energyshift"
set ylabel "Energy per atom (eV)"
plot "energyshift_convergence.dat" using 1:3 with linespoints lw 2 pt 7 lc rgb "#2255cc" title "E/atom"

set title "Convergence: energyshift (relaxed cell volume)"
set xlabel "energyshift"
set ylabel "Volume (Ang^3)"
plot "energyshift_convergence.dat" using 1:5 with linespoints lw 2 pt 7 lc rgb "#cc5522" title "Volume"

unset multiplot
